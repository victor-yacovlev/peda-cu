"""Minimal type stub for the GDB Python API.

Only the surface used by peda.py. The real module is provided by GDB's
embedded interpreter; this stub exists so static checkers can resolve it.
"""

from typing import Any, Iterable, Optional

# command classes (gdb.Command)
COMMAND_NONE: int
COMMAND_RUNNING: int
COMMAND_DATA: int
COMMAND_STACK: int
COMMAND_FILES: int
COMMAND_SUPPORT: int
COMMAND_STATUS: int
COMMAND_BREAKPOINTS: int
COMMAND_TRACEPOINTS: int
COMMAND_USER: int
# completion classes
COMPLETE_NONE: int
COMPLETE_FILENAME: int
COMPLETE_LOCATION: int
COMPLETE_COMMAND: int
COMPLETE_SYMBOL: int
COMPLETE_EXPRESSION: int

class Command:
    def __init__(self, name: str, command_class: int, *, prefix: bool = ..., complete_class: int = ...) -> None: ...
    def dont_repeat(self) -> None: ...
    def invoke(self, arg: str, from_tty: bool) -> None: ...
    def complete(self, text: str, word: str) -> Optional[list[str]]: ...

class Objfile:
    filename: str
    pretty_printers: list[Any]

class Inferior:
    pid: int
    def read_memory(self, address: int, length: int) -> Any: ...
    def write_memory(self, address: int, buffer: Any) -> None: ...

def execute(command: str, *, to_string: bool = ..., from_tty: bool = ...) -> Optional[str]: ...
def flush() -> None: ...
def parse_and_eval(expression: str) -> Any: ...
def selected_inferior() -> Inferior: ...
def selected_frame() -> Any: ...
def objfiles() -> Iterable[Objfile]: ...
def breakpoints() -> Iterable[Any]: ...
def string_to_argv(arg: str) -> list[str]: ...
def write(text: str) -> None: ...
def parameter(name: str) -> Any: ...
def set_parameter(name: str, value: Any) -> None: ...
def convenience_vars() -> dict[str, Any]: ...
def history(number: int) -> Any: ...
